generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  devices      Device[]
  activityLogs ActivityLog[]
  dailySummaries DailySummary[]
  customCategories CustomCategory[]
}

model Device {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deviceName String
  deviceType String
  createdAt  DateTime @default(now())

  activityLogs ActivityLog[]

  @@index([userId])
}

model ActivityLog {
  id              String   @id @default(uuid())
  userId          String
  deviceId        String
  createdAt DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
  device          Device   @relation(fields: [deviceId], references: [id])

  domain          String
  title           String
  durationSeconds Int
  category        String?
  confidence      Float?
  timestamp       DateTime
  processed       Boolean  @default(false)

  @@index([userId])
  @@index([deviceId])
  @@index([timestamp])
}

model DailySummary {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime
  productiveTime  Int      @default(0)
  distractingTime Int      @default(0)
  neutralTime     Int      @default(0)
  learningTime    Int      @default(0)
  totalTime       Int      @default(0)
  score           Float    @default(0)
  computedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
}

model CustomCategory {
  id       String @id @default(uuid())
  userId   String
  domain   String
  category String

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, domain])
  @@index([userId])
}