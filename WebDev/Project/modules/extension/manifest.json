{
    "manifest_version": 2,
    "name": "Smart Digital Wellbeing Tracker",
    "version": "1.14",
    "description": "Tracks browsing activity and sends it to the Smart Digital Wellbeing Platform.",
    "permissions": [
        "tabs",
        "activeTab",
        "storage",
        "idle",
        "windows"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "scripts": [
            "browser-polyfill.js",
            "background.js"
        ],
        "type": "module",
        "persistent": true
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "browser-polyfill.js",
                "content.js"
            ]
        }
    ],
    "browser_action": {
        "default_popup": "popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "activity-tracker@wellbeing-platform"
        }
    }
}